#!/usr/bin/env bash

### Использование:
##################
#-> Создать зону
#fwperm new-zone-my_zone (firewall-cmd --permanent --new-zone=my-zone)
#-> Добавить интерфейс в зону
#fwperm add-iface-zone-my_zone-eth0 (firewall-cmd --permanent --zone=my-zone --add-interface=eth0)
#-> Включить маскарадинг
#fwperm add-masq-zone-my_zone (firewall-cmd --permanent --zone=my-zone --add-masquerade)
#->Добавить сервис http в зону
#fwperm add-service-zone-my_zone-http
#-> Добавить сервис https в зону (с дефисом в имени зоны через _)
#fwperm add-service-zone-prod_web-https
#-> Direct rule: FORWARD awg0 → eth0
#fwperm add-fwd-ipv4-awg0-eth0 (firewall-cmd --permanent --direct --add-rule ipv4 filter FORWARD 0 -i awg0 -o eth0 -j ACCEPT)
#-> Удалить зону
#fwperm del-zone-my_zone
#-> Убрать интерфейс из зоны
#fwperm del-iface-zone-my_zone-eth0
#-> Fallback: полная команда, если сокращения нет
#fwperm --list-all-zones (firewall-cmd --permanent --list-all-zones)

dbg=1
me="${0##*/}"

dbg_cmd() { printf '\033[1;1m%s\033[0m\n' "[#] $*" >&2; "$@"; }
color_cmd() { local cmd="$*"; { out=$($cmd); exit_code=$?; } && printf '\033[1;32m%s\033[0m\n' "$out" || { printf '\033[1;31m%s\033[0m\n' "$out"; exit "$exit_code"; }; }
die() { printf '\033[1;31m%s\033[0m\n' "$me: $*" >&2; exit 1; }

fwperm_cmd() {
    [[ "$dbg" = 0 ]] > /dev/null 2>&1 && color_cmd firewall-cmd --permanent "$@" || dbg_cmd firewall-cmd --permanent "$@"
}

# Underscore → hyphen в значениях, чтобы '-' работал только как разделитель токенов
v() { printf '%s' "${1//_/-}"; }

fwperm() {
    local -a t
    IFS='-' read -ra t <<< "$1"
    case "${t[0]}" in
    new)
        case "${t[1]}" in
            zone)
                fwperm_cmd --new-zone="$(v "${t[2]}")"
                ;;
        esac
        ;;

    add)
        case "${t[1]}" in
            iface)
                # add-iface-zone-<zone>-<iface>
                case "${t[2]}" in
                    zone)
                        fwperm_cmd --zone="$(v "${t[3]}")" --add-interface="$(v "${t[4]}")"
                        ;;
                esac
                ;;
            masq)
                # add-masq-zone-<zone>
                case "${t[2]}" in
                    zone)
                        fwperm_cmd --permanent --zone="$(v "${t[3]}")" --add-masquerade
                        ;;
                esac
                ;;
            service)
                # add-service-zone-<zone>-<service>
                case "${t[2]}" in
                    zone)
                        fwperm_cmd --zone="$(v "${t[3]}")" --add-service="$(v "${t[4]}")"
                        ;;
                esac
                ;;
            fwd)
                # add-fwd-<ipv4[6]>-<in_iface>-<out_iface>
                fwperm_cmd --direct --add-rule "$(v "${t[2]}")" filter FORWARD 0 -i "$(v "${t[3]}")" -o "$(v "${t[4]}")" -j ACCEPT
                ;;
        esac
        ;;

    del)
        case "${t[1]}" in
            zone)
                color_cmd firewall-cmd --permanent --delete-zone="$(v "${t[2]}")"
                ;;
            iface)
                # del-iface-zone-<zone>-<iface>
                case "${t[2]}" in
                    zone)
                        color_cmd firewall-cmd --permanent --zone="$(v "${t[3]}")" --remove-interface="$(v "${t[4]}")"
                        ;;
                esac
                ;;
        esac
        ;;

    *)
        fwperm_cmd "$@"
        ;;
    esac
}

fwperm "$@"
