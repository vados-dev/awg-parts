#!/usr/bin/env bash

### Использование:
##################
#-> fwcmd [ОПЦИИ]
# -rl, reload               Перечитать конфиги
# -la, list-all             Вывод всех правил
# -laz, list-all-zones      Вывод всех зон
# -gaz, get-active-zones    Вывод активных зон
# -t, test                  Запустить тестовую функцию (можно использовать \$2)
# -h, --help                Показать эту справку и выйти

set -euo pipefail

# Common vars
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "${SELF}")"
export PATH="${SELF_DIR}:$PATH"
ME_SELF="${SELF##*/}"
ME_CLEAN="${ME_SELF%.*}"
PROGRAM="${0##*/}"
ARGS=( "$@" )
PARENT_DIR="$(dirname "${SELF_DIR}")"
dbg=0
me="${0##*/}"

if [ -t 0 ]; then
  cmd()  { printf '  [\033[1;33m✨\033[0m]\033[1m %s \033[0m\n' "$*" >&2; "$@"; }
  color_cmd() { local cmd="$*"; { out=$($cmd); exit_code=$?; } && printf ' \033[1;32m%s\033[0m\n' "$out" || { printf ' \033[1;31m%s\033[0m\n' "$out"; exit "$exit_code"; }; }
  dbg_cmd() { printf '\033[1;1m%s\033[0m\n' "[#] $*" >&2; "$@"; }
  log()  { printf ' \033[1;34m 📋 INFO:\033[0;8m [%s] - %s.\033[0m\n' "$PROGRAM" "$*"; }
  warn() { printf ' \033[1;33m ⚡ WARN:\033[0;1m [%s] - %s.\033[0m\n' "$PROGRAM" "$*" >&2; }
  err()  { printf ' \033[0;31m ⚫ ERROR:\033[0;1m [%s] - %s!\033[0m\n' "$PROGRAM" "$*" >&2; }
  die()  { printf ' \033[1;31m ❌ CRITICAL:\033[0;1m [%s] - %s!\033[0m\n' "$PROGRAM" "$*" >&2; exit 1; }
else
  cmd()  { printf '  [*] %s\n' "$*" >&2; "$@"; }
  color_cmd() { local cmd="$*"; { out=$($cmd); exit_code=$?; } && printf '%s\n' "$out" || { printf '%s\n' "$out"; exit "$exit_code"; }; }
  dbg_cmd() { printf '%s\n' "[#] $*" >&2; "$@"; }
  log()  { printf ' [INFO] [%s] - %s.\n' "$PROGRAM" "$*"; }
  warn() { printf ' [WARN] [%s] - %s.\n' "$PROGRAM" "$*" >&2; }
  err()  { printf ' [ERROR] [%s] - %s!\n' "$PROGRAM" "$*" >&2; }
  die()  { printf ' [CRITICAL] [%s] - %s!\n' "$PROGRAM" "$*" >&2; exit 1; }
fi

usage() { sed -n '2,12p' "${SELF}" | sed 's/^# \{0,1\}//'; }

fw_cmd() { [[ "$dbg" = 0 ]] > /dev/null 2>&1 && color_cmd firewall-cmd "$@" || dbg_cmd firewall-cmd "$@"; }

show_command() { printf "Запуск %s c аргументами: [ %s ].\n" "$0" "$*"; }

def_cmd() {
    if ! fw_check_xml 2>&1; then
        _arg=${1:-"--help"}
        show_command "$0" "${_arg}"
        _ret=$($0 $_arg 2>&1)
        if [ $? -eq 0 ]; then
            printf "%s\n" "${_ret}"
        else
            printf "%s\n" "${_ret}"
        fi
    fi
}

check_xml() { ! command -v grep "error" | /etc/firewalld/tools/check.sh > /dev/null 2>&1 || die "Ошибка в XML файле $0"; }

run_once() {
    if ! check_xml 2>&1; then
        _run="echo -en"
        _arg="$ARGS"
        show_command "${_run}" "${_arg}"
        printf "%s\n" "${ret}"
    fi
}

run_cmd() {
    if ! check_xml 2>&1; then
        show_command "$0" "$@"
        _ret=$($0 $@ 2>&1)
        if [ $? -eq 0 ]; then
            printf "%s\n" "${_ret}"
        else
            printf "%s\n" "${_ret}"
        fi
    fi
}
run_test_cmd() {
    var="$ARGS"
    $(echo "${ARGS})")
    if [ $? -eq 0 ]; then
        printf "%s\n" "$var"
    fi
}

fwcmd() {
    [ $# -gt 0 ] || { warn "Запуск без аргументов"; color_cmd usage; exit 2; }
    local key="$1"
    while [[ $# -gt 0 ]]; do
        case $1 in
            -rl |reload)            fw_cmd --reload; break ;;
            -pmt|perm)              fw_cmd --permanent "$@"; break ;;
            -la |list-all)          fw_cmd --list-all; break ;;
            -laz|list-all-zones)    fw_cmd --list-all-zones; break ;;
            -gaz|get-active-zones)  fw_cmd --get-active-zones; break ;;
            -t  |test)              fw_cmd "$@"; break ;;
            -chk|chkxml)            check_xml; break ;;
            -h  |--help)            color_cmd usage;break ;;
            *) fw_cmd "$@" ;;
            # || color_cmd usage; exit 2 ;;
            #RUN_CMD="run_once";   RUN="$1"; ARGS="$1"; break ;;
        esac
        shift
    done
}

fwcmd "$@"

