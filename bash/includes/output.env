tocenter=$(tput hpa $(tput cols));
TERM_COLS=$(tput cols)  # ширина
TERM_ROWS=$(tput lines)  # высота
CENTER_COL=$((TERM_COLS / 2))
CENTER_ROW=$((TERM_ROWS / 2))
# Перемещаем курсор в рассчитанную позицию
ABS_CENTER=$(tput cup $CENTER_ROW $CENTER_COL);
TOP_CENTER=$(tput hpa ${CENTER_COL});


strip_colors() { echo "$1" | sed 's/\x1b\[[0-9;]*m//g'; }

### _vlen <string>:
#—> видимая длина строки (без ANSI-кодов) Работает и с \e[32m, и с реальными ESC-байтами
_vlen() {
  local s
  s=$(printf '%s' "$1" | sed -E 's/\\e/\x1b/g; s/\x1b[[:alnum:];]*[mK]//g')
  printf '%d' "${#s}"
}

align::left() {
  local -i width=${1:-$COLS_NUM}
  local -- txt=${2:-}
  local str=$(strip_colors "$txt")
  [[ -z $width ]] && width=80
  local -i length
  length=$(_vlen "$str")
  (( length >= width )) && { printf '%b' "${str:0:width}"; return; }
  local -i pad_right=$((width - length))
  printf '%b%*s' "$str" "$pad_right" ''
}

align::right() {
  local -i width=${1:-$COLS_NUM}
  local -- str=${2:-}
  [[ -z $width ]] && width=80
  local -i length
  length=$(_vlen "$str")
  (( length >= width )) && { printf '%b' "${str:0:width}"; return; }
  local -i pad_left=$((width - length))
  printf '%*s%b' "$pad_left" '' "$str"
}

align::center() {
  local -i width=${1:-$COLS_NUM}
  local -- str=${2:-}
  [[ -z $width ]] && width=80
  local -i length
  length=$(_vlen "$str")
  (( length >= width )) && { printf '%b' "${str:0:width}"; return; }
  local -i pad_left=$(( (width - length) / 2 ))
  local -i pad_right=$((width - length - pad_left))
  printf '%*s%b%*s' "$pad_left" '' "$str" "$pad_right" ''
}

# Выравнивание ячейки по ШИРИНЕ В СИМВОЛАХ. printf считает байты, поэтому колонка с кириллицей съезжает ровно на число многобайтовых символов.
_cols_pad() {
    local s="$1" w="$2" chars bytes
    chars=${#s}
    bytes=$(LC_ALL=C printf '%s' "$s" | wc -c)
    printf '%-*s ' "$((w + bytes - chars))" "$s"
}



stars=${byel}'✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨✨'${nc};
line='##############################################################';
equals='═══════════════════════════════════════════════════════════════════════════════'
spaces='                                                                               '
clean_lines() {
    NUM="0"
    while [ "$NUM" -lt "$1" ]; do
        printf '\033[1A'
        printf '\033[2K'
        NUM=$((NUM + 1))
    done
}
print_line() {
    NUM="0"
    while [ "$NUM" -lt "$2" ]; do
        printf "$1"
        NUM=$((NUM + 1))
    done
    printf "\n"
}
dashes="$(print_line ─ $COLS_NUM)"
equals="$(print_line ═ $COLS_NUM)"
big_dashes="$(print_line ━ $COLS_NUM)"

ok_box() {
    local _ok=$(log_ok "$*"); line="$(cecho Gs ${dashes})"
    printf "    %s\n" "$(align::left $COLS_NUM "$line")"
    printf "    %s\n" "$(align::left $COLS_NUM "$_ok")"
    printf "    %s\n" "$(align::left $COLS_NUM "$line")"
}
sccess_box() { ok_box "$*"; }
failure_box() {
    local _err=$(log_error "$*"); line="$(cecho Rs ${dashes})"
    printf "    %s\n" "$(align::left $COLS_NUM "$line")"
    printf "    %s\n" "$(align::left $COLS_NUM "$_err")"
}
warning_box() {
    local _warn=$(log_warn "$*"); line="$(cecho Ys ${dashes})"
    printf "    %s\n" "$(align::left $COLS_NUM "$line")"
    printf "    %s\n" "$(align::left $COLS_NUM "$_warn")"
}


print_banner() {
    local title="${1:-$mTitle}" desc="$2"
    printf "${bmag}┌──────────────────────────────────────────────────────────────────────────────${nc}\n";
    printf "${bmag}│   ${sym_star}${bnc}   $title   ${sym_star}                                   ${nc}\n";
    printf "${bmag}└──────────────────────────────────────────────────────────────────────────────${nc}\n";
    if [[ -n "$desc" ]]; then
        printf "\n  ${bnc} %s${nc}\n" " ${desc//$'\n'/$'\n'  }"
        printf "${nc}${bmag}%s\n${nc}" "$dashes"
    fi
}

show_window_head() {
    local LINES=$(tput lines)
    local COLS=$(tput cols)
    local colmax=2
    local offset=$(( $COLS / $colmax ))
    local lastrow=`get_cursor_row`
    local lastcol=`get_cursor_col`
    trap "cursor_blink_on; stty echo; printf '\n'; exit" 2
#    cursor_blink_off
#    _tty_reset
    local _str="$(cecho sWb "  $pr_name $app_version  ")$(cecho sW │)$(cecho sWm "  ${mTitle}  ")$(cecho sW │)$(cecho sWb "  Хост: ")$(cecho sfWb "$(hostname)  ")$(cecho sW │)$(cecho sWb " (un)select all : key ([n])[a] ")$(cecho sW │)$(cecho sWb " move : arrow up/down/left/right or keys k/j/l/h ")$(cecho sW │)$(cecho sWb " validation : [enter] ")$(cecho sW │)$(echo -e ${blub})"
#    local _str="$(cecho sWb "  $pr_name $app_version  │)$(cecho sWm "  ${mTitle}  ")$(cecho sWb "│  Хост: ")$(cecho sfWb "$(hostname)  ")$(cecho sWb "│  (un)select all : key ([n])[a]  │  move : arrow up/down/left/right or keys k/j/l/h  │  validation : [enter]  │")$(echo -e ${blub})"
# column -t -s '|')"
#    local top_str=$(align::left $(tput cols) "$_str")
    printf "%s${nc}\n" "$(align::left $((${COLS} + 176)) "$_str")"
#    cursor_to $((${lastrow} + 2)) "$tocenter"
#    printf "\n"
    cursor_blink_on
}

cols_to_center() {
    local -- str=${1}
    local -i len=${str#}
    local -i offset=$((len / 2))
    local start=$(tput hpa $((${CENTER_COL} - offset)))
    printf "$start %s" "$str"
}

