### Функции отрисовки менюшек:
##############################
#-> Помогаторы:
menu_pause() { echo ""; _read_line "$(cecho sW '    Нажмите Enter для возврата в меню...')" _; }
press_continue() { echo ""; _read_line "$(cecho sW '    Нажмите Enter для продолжения...')" _; }
#-> Главное меню и меню разделов:
show_menu() {
    wg_header
    while true; do
        local choice
        local index=0
        printf "${blub}╔%s╗${nc}\n" "$(align::center $COLS_NUM "$equals ${mTitle} $equals")"
        printf "${blub}║%s║${nc}\n" "$(align::center $COLS_NUM " ")"
        for idx in ${!mItems[@]}; do
            printf "${blub}║%s║${nc}\n" "$(align::left $COLS_NUM "  $((idx + 1))  -  ${mItems[$idx]}")"
            index=$((index + 1))
        done
        printf "${blub}║ ${und}%s${nc}${blub} ║${nc}\n" "$(align::center $((COLS_NUM-2)) ' ')"
        printf "${magb}║%s║${nc}\n" "$(align::center $COLS_NUM " ")"

        if [[ "$mType" != "main" ]]; then
            printf "${magb}║%s║${nc}\n" "$(align::left $COLS_NUM " 0  -  Назад")"
        fi

        printf "${redb}║%s║${nc}\n" "$(align::left $COLS_NUM " q  -  Выход")"
        printf "${redb}╚%s╝${nc}\n" "$(align::center $COLS_NUM "$equals")"
        _read_choice choice
        printf "${bnc}"

        if [[ "$mType" != "main" ]] && [[ "$choice" == "0" ]]; then
            echo
            printf '    %s\n\n' "$(cecho sY "Возврат.")"
            return 0
        fi

        if [[ "$choice" == "q" ]]; then
            printf "\n    ${bred}%s\n${nc}\n" "Выход."
            rm -f $PROJ_LOCK_FILE
            exit 0
        fi

        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#mActions[@]} )); then
            "${mActions[choice - 1]}"
            if [[ "$mType" == "section" ]] && [[ "$choice" != "0" ]]; then
                menu_pause
            elif [[ "$mType" == "select" ]]; then
                return 0
            else
                _flush_stdin
            fi
        else
            local enterExit="\n    Для выхода введите \"${byel}q${bmag}\"."
            if [[ "$mType" == "main" ]]; then
                backOrExit=${enterExit}
            else
                backOrExit="\n    Либо введите \"${byel}0${bmag}\" для возврата пердыдущее меню.${enterExit}"
            fi
            printf "\n${bmag}    Введите число от \"${byel}1${bmag}\" до \"${byel}%d${bmag}\".${backOrExit}${nc}\n\n" ${index}
            menu_pause
        fi
        wg_header
    done
}

### Динамическое меню выбора:
select_menu() {
    while true; do
        local choice
        local index=0
        local def_num=$((${sDefault} - 1))
        echo
        printstr '%s\n' "${sTitle}"
        for idx in ${!sItems[@]}; do
            if [[ "${idx}" == "${def_num}" ]]; then
                printselect "$((idx + 1))" "${sItems[$idx]}" "по умолчанию"
            else
                printselect "$((idx + 1))" "${sItems[$idx]}"
            fi
            index=$((index + 1))
        done
        _read_choice choice
        printf "${bnc}"

        [[ "$choice" == "0" ]] && log_cancel; return 1

        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#sArr[@]} )); then
            "${sArr[choice - 1]}"
                return 0
        else
            local enterReturn="$(cecho sM "Для отмены введите \"")$(cecho sY "0")$(cecho sM "\".")"
            echo
            printf "    $(cecho sM "Введите число от \"")$(cecho sY 1)$(cecho sM "\" до \"")$(cecho sY "%d")$(cecho sM "\".")\n${enterReturn}\n\n" ${index}
            menu_pause
        fi
    done
}
###################
### Менюшки выбора:
###################
### Легенды для менюшек выбора:
#-> Легенда в строке статуса (подвал):
multi_legend() {
    if [[ $1 = "true" ]]; then
        local lastrow=`get_cursor_row`
        local lastcol=`get_cursor_col`
        cursor_to $(( ${TERM_ROWS} - 2 ))
        local clr_len=' Действия: │ Выбрать: [пробел] │ (снять)выбрать все: ([n])[a] │ перемещение: →/←/↑/↓ или k/j/l/h │ применить выбор: [Enter] │ возврат: 0 '
        printf "_%.s" $(seq ${TERM_COLS})
        printf '    %s\n' "$(align::left $TERM_COLS "$clr_len")"
        cursor_to "$lastrow" #        printf "\n" #        cursor_blink_on #        return 0
    fi
}

#-> Легенда в скобки запроса выбора:
mini_legend() { [[ $1 = "true" ]] && printf ' %s' "([Пробел] - Выбрать │ ↑/↓ - Перемещение │ [Enter] - Применить │ 0 - Возврат)"; }

### Менюшка выбора нескольких опции (галочками):
#-> Описание:
# multiselect - это чисто bash-реализация меню с несколькими вариантами выбора.
# Если в качестве первого аргумента передается значение "true", то выводится справка будет напечатана до отображения параметров.
# Любое другое значение скроет его. Результат будет сохранен в виде массива в переменной,
# которая передается в multiselect в качестве второго аргумента. Третий аргумент принимает массив, содержащий все доступные параметры.
# Четвёртый аргумент необязателен и может использоваться для предварительного выбора определенных параметров.
# Если он используется, то это должен быть массив, который имеет значение "true" для каждого индекса параметров массива, который должен быть предварительно выбран.
# Пятый аргумент строка запроса.
#
# Пример:
#########
# arr_list=("Option 1" "Option 2" "Option 3")
# preselection=("true" "true" "false"), либо false если выбор не требуется
# med_multiselect "true" result _list preselection "Выберите опции"
#
# Обработка результата:
#    idx=0
#    ret_val=()
#    for option in "${arr_list[@]}"; do
#        [ "${result[idx]}" = true ] && ret_val+=("${option}")
#        ((idx++))
#    done
# В результате будет наполнен массив "ret_val()" с выбранными пунктами
######################################################################
med_multiselect() {
    local help_flag=$1 return_value=$2; local -n options=$3
    local -n defaults=$4; local prompt="$5"
    local legend=$(mini_legend "$help_flag"); local selected=()
    printf '    %s%s:\n' "$prompt" "$legend"
    for ((i = 0; i < ${#options[@]}; i++)); do
        [[ ${defaults[i]} = "true" ]] && selected+=("true") || selected+=("false")
        printf "\n"
    done
    local lastrow=$(get_cursor_row)
    local startrow=$(($lastrow - ${#options[@]}))
    trap "cursor_blink_on; stty echo; printf '\n'; exit" 2
    cursor_blink_off
    toggle_option() {
        local option=$1
        [[ ${selected[option]} == true ]] && selected[option]=false || selected[option]=true
    }
    print_options() {
        local idx=0
        for option in "${options[@]}"; do
            local prefix="$sym_unsel"
            [[ ${selected[idx]} == true ]] && prefix="$sym_sel"
            cursor_to "$((startrow + idx))"
            [ "$idx" -eq "$1" ] && print_active "$option" "$prefix" || print_inactive "$option" "$prefix"
            ((idx++))
        done
    }
    to_exit() { cursor_to "$lastrow"; printf "\n"; cursor_blink_on; }
    local active=0
    while true; do
        print_options "$active"
        case $(key_input) in
        space) toggle_option "$active" ;;
        enter)
            print_options -1
            break ;;
        up)
            ((active--))
            ((active < 0)) && active=$(( ${#options[@]} - 1 )) ;;
        down)
            ((active++))
            ((active >= ${#options[@]})) && active=0 ;;
        cancel)
            to_exit; log_cancel; return 1 ;;
        esac
    done
#    set +x
    to_exit
    eval "$return_value"='("${selected[@]}")'
}

### Менюшка выбора одной опции (галочкой):
#-> Использование:
# single_select_menu "true" result array default_value "Текст запроса"
# Где:
#      $1 - выводить ли легенду ("true" или "false")
#      $2 - что вернёт (прямо так, без бакса)
#      $3 - из чего выбирать (прямо так, без бакса)
#      $4 - выбрано по умолчанию
#      $5 - текст запроса (если включена легенда, она будет добавлена в скобках к тексту запроса)
#
# Пример:
#########
# single_select_menu "true" result array 2 "Выберите одну опцию"
# Обработка результата: просто возврат переменной ($result).
single_select() {
    local help_flag=$1 return_value=$2; local -n options=$3
    local default_selection="${4:-0}" prompt="$5"
    local legend=$(mini_legend "$help_flag")
    printf '    %s%s:\n' "$prompt" "$legend"
    for ((i = 0; i < ${#options[@]}; i++)); do
        printf "\n"
    done
    local lastrow=$(get_cursor_row)
    local startrow=$(($lastrow - ${#options[@]}))
    trap "cursor_blink_on; stty echo; printf '\n'; exit" 2
    cursor_blink_off
    print_options() {
        local idx=0
        for option in "${options[@]}"; do
            local prefix="$sym_unsel"
            [[ $idx -eq $selected ]] && prefix="$sym_sel"
            cursor_to "$((startrow + idx))"
            [ "$idx" -eq "$active" ] && print_active "$option" "$prefix" || print_inactive "$option" "$prefix"
            ((idx++))
        done
    }

    to_exit() { cursor_to "$lastrow"; printf "\n"; cursor_blink_on; }
    local selected=$default_selection
    local active=0
    while true; do
        print_options "$active"
        case $(key_input) in
        space)
            if [ "$active" -eq "$selected" ]; then
                selected=-1
            else
                selected=$active
            fi
            ;;
        enter)
            local active=-1
            print_options "$active"
            break
            ;;
        up)
            ((active--))
            ((active < 0)) && active=$(( ${#options[@]} - 1 ))
            ;;
        down)
            ((active++))
            ((active >= ${#options[@]})) && active=0
            ;;
        cancel)
            to_exit; log_cancel; return 1 ;;
        esac
    done
    cursor_to "$lastrow"
    printf "\n"
    cursor_blink_on
    if [ "$selected" -eq -1 ]; then
        eval "$return_value"='("")'
    else
        eval "$return_value"='"${options[$selected]}"'
    fi
}

### Большое Multi-select меню:
##############################
#-> Проверкка размера окна:
checkwinsize() {
    local __items=$1 __lines=$2
    [ $__items -ge $__lines ] && return 1 || return 0
}

function multiselect_43m {
    local help_flag=false
    local return_value=$1
    local colmax=$2
    local offset=$3
    local size=$4
    shift 4
    local options=("$@")
    shift $size
    local lastrow=`get_cursor_row`
    for i in $(seq 0 $size); do
        unset options[$(( $i + $size ))]
    done
    local defaults=("$@")
    shift $size
    unset defaults[$size]

    printf '\n    %s' "$(cecho sW "$msPrompt")"

#   local options=("${!tmp_options}")#   local defauts=("${!tmp_defaults}")
    err=`checkwinsize $(( ${#options[@]}/$colmax )) $(( ${TERM_ROWS} - 2)); echo $?`
    if [[ ! $err == 0 ]]; then
        log_error "Размер вашего окна ${TERM_ROWS} строк, что несовместимо с количеством пунктов меню ${#msItems[@]}!"
        cursor_to $lastrow
        return 1
    fi
    local selected=()
    for ((i=0; i<${#options[@]}; i++)); do
        [[ ${msDefaults[i]} = "true" ]] && selected+=("true") || selected+=("false")
        printf "\n"
    done

    multi_legend "$help_flag"

    local lastrow=`get_cursor_row`
    local lastcol=`get_cursor_col`
    local startrow=$(($lastrow - ${#options[@]}))
    local startcol=$(($lastcol - ${#options[@]}))
    trap "cursor_blink_on; stty echo; printf '\n'; exit" 2
    cursor_blink_off

    toggle_option() {
        local option=$1
        [[ ${selected[option]} == true ]] && selected[option]=false || selected[option]=true
    }
    toggle_option_multicol() {
        local option_row=$1
        local option_col=$2
    if [[ $option_row -eq -10 ]] && [[ $option_row -eq -10 ]]; then
        for ((option=0;option<${#selected[@]};option++)); do
            selected[option]=true
        done
    else
        if [[ $option_row -eq -100 ]] && [[ $option_row -eq -100 ]]; then
            for ((option=0;option<${#selected[@]};option++)); do
                selected[option]=false
            done
        else
            option=$(( $option_col + $option_row * $colmax ))
                [[ ${selected[option]} == true ]] && selected[option]=false || selected[option]=true
        fi
    fi
    }

    print_options_multicol() {
        local curr_col=$1 curr_row=$2 curr_idx=0 idx=0 row=0 col=0
        curr_idx=$(( $curr_col + $curr_row * $colmax ))
        for option in "${options[@]}"; do
            local prefix="[ ]"
            [[ ${selected[idx]} == true ]] && prefix="[\e[38;5;46m✔\e[0m]"
            row=$(( $idx/$colmax ))
        col=$(( $idx - $row * $colmax ))
            cursor_to $(( $startrow + $row + 1)) $(( $offset * $col + 1))
            [ $idx -eq $curr_idx ] && print_active "$option" "$prefix" || print_inactive "$option" "$prefix"
            ((idx++))
        done
    }
    local active_row=0
    local active_col=0
    while true; do
        print_options_multicol $active_col $active_row
        case `key_input` in
            space)  toggle_option_multicol $active_row $active_col;;
            enter)  print_options_multicol -1 -1; break;;
            up)     ((active_row--));
                    if [ $active_row -lt 0 ]; then active_row=0; fi;;
            down)   ((active_row++));
                    if [ $active_row -ge $(( ${#options[@]} / $colmax ))  ]; then active_row=$(( ${#options[@]} / $colmax )); fi;;
            left)     ((active_col=$active_col - 1));
                    if [ $active_col -lt 0 ]; then active_col=0; fi;;
            right)     ((active_col=$active_col + 1));
                    if [ $active_col -ge $colmax ]; then active_col=$(( $colmax -1 )) ; fi;;
            all)    toggle_option_multicol -10 -10 ;;
            none)   toggle_option_multicol -100 -100 ;;
            cancel) log_cancel; return 1 ;;
        esac
    done
    cursor_to $lastrow
    printf "\n"
    cursor_blink_on
    eval $return_value='("${selected[@]}")'
}
