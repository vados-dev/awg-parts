
### Функции контроля курсора:
#############################
ESC=$( printf "\033")
cursor_blink_on()   { printf "$ESC[?25h"; }
cursor_blink_off()  { printf "$ESC[?25l"; }
cursor_to()         { printf "$ESC[$1;${2:-1}H"; }
cursor_move_up()    { printf "$ESC[${1}A"; }
cursor_move_down()  { printf "$ESC[${1}B"; }
cursor_move_left()  { printf "$ESC[${1}D"; }
cursor_move_right() { printf "$ESC[${1}C"; }
print_inactive()    { printf "    $2   $1 "; }
print_active()      { printf "    $2  $ESC[7m $1 $ESC[27m"; }
get_cursor_row()    { IFS=';' read -sdR -p $'\E[6n' ROW COL; echo ${ROW#*[}; }
get_cursor_col()    { IFS=';' read -sdR -p $'\E[6n' ROW COL; echo ${COL#*[}; }
key_input() {
    local key
    IFS= read -rsn1 key 2>/dev/null >&2
    if [[ $key = ""      ]]; then echo enter; fi;
    if [[ $key = $'\x20' ]]; then echo space; fi;
    if [[ $key = "k" ]]; then echo up;    fi;
    if [[ $key = "j" ]]; then echo down;  fi;
    if [[ $key = "h" ]]; then echo left;  fi;
    if [[ $key = "l" ]]; then echo right; fi;
    if [[ $key = "a" ]]; then echo all;   fi;
    if [[ $key = "n" ]]; then echo none;  fi;
    if [[ $key = "0" ]]; then echo cancel;  fi;
    if [[ $key = $'\x1b' ]]; then
        read -rsn2 key
        if [[ $key = [A || $key = k ]]; then echo up;     fi;
        if [[ $key = [B || $key = j ]]; then echo down;   fi;
        if [[ $key = [C || $key = l ]]; then echo right;  fi;
        if [[ $key = [D || $key = h ]]; then echo left;   fi;
    fi
}

### Функции очистки:
####################
#-> Полная очистка терминала
cls() { clear && printf '\e[3J'; }
#-> Очистить до конца строки
clnstr() { _tty_reset; printf '%s%s' "$ESC" '[K'; }

### Основная модель формирования строк вывода:
##############################################
app_title() {
    local name=${pr_name:-$dir_name};
    #printf " ${bnc}[${nc}${bmag}${name}${bnc}]${nc}";
    #-> Просто сдвиг на 3 пробела. Выше подставляется имя из переменной \$pr_name
    printf '   ';
}
printstr() {
    local _head="$(app_title)";
    if [[ "$#" == 4 ]]; then
       printf "$(cecho Ws "$_head") %s $2$(cecho Ws "$1")$(cecho sY "$3")" "$4";
    elif [[ "$#" == 3 ]]; then
       printf "$(cecho Ws "$_head") %s $(cecho Ws "$1")$(cecho sY "$2")" "$3";
    elif [[ "$#" == 2 ]]; then
       printf "$(cecho Ws "$_head") %s $(cecho Ws "$1")" "$2";
    elif [[ "$#" == 1 ]]; then
       printf "$(echo $_head)$*"
    fi
       printf '\n'
}

printselect() {
    local _start='    ';
    if [[ "$#" == 3 ]]; then
       printf "$(cecho sW "$_start") $(cecho sY "%s")$(cecho sW ") -") $(cecho sG "%s") $(cecho sW "(%s)")\n" "$1" "$2" "$3";
    elif [[ "$#" == 2 ]]; then
       printf "$(cecho sW "$_start") $(cecho sM "%s")$(cecho sW ") - %s")\n" "$1" "$2";
#    else #       printf "$(cecho sW "$_head") $(cecho sW "%s")\n" "$1";
    fi
}

#-> Спиннер
auto_log() {
    local _run="$1" delay=0.15
    custom_spin_max_time="${2:-${spin_max_time}}"
    custom_spin_color="${3:-${spin_color}}"
    unset_spin(){ printf "\r$(clnstr)"; unset custom_spin_color; unset custom_spin_max_time; }
    local msg="${4:-"Выполнение:"}"
#    local -a spn20cols=("Ws" "Cs" "Gs" "Ys" "Rs" "Ms" "Bs" "Cs" "Ws" "Ys" "Gs" "Bs" "Ms" "Rs" "Ys" "Ws" "Cs" "Bs" "Gs" "Ys")
#    local spinmod="20"
#    local ind=0#("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏" "⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏") #("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    local tmp=$(mktemp);
    "$_run" >"$tmp" 2>&1 &
    local -r pid=$!; local name
    if [[ -z "$name" ]] 2>/dev/null; then name="$_run"; else name=$(ps a | awk '{print $1}' | grep -q "${pid}" || unset name; log_msg "spin_err" "    Процесс с PID ${pid} не найден."); fi
    local max_ticks=$(awk "BEGIN{printf \"%d\", (${custom_spin_max_time} / ${delay})}")
    local i=0 tick=0 spinmod="20"
    local -a sym
    mapfile -t sym < <(spn20)
    while kill -0 "$pid" > /dev/null 2>&1; do
       log_msg "spin_wait" "${msg} ${name}" "${sym[i]}"
       i=$(( (i + 1) % spinmod ))
       sleep "${delay}"
       ((tick++))
       if (( tick >= max_ticks )); then
           kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null || true
           local out=$(<"$tmp"); rm -f "$tmp"; unset_spin
           log_msg "spin_warn" "Таймаут [${max_ticks}ms], команда: ${name} ${out:+ : $out}" "$sym_warn"
           return 13
       fi
    done
    wait "$pid"; local rc=$?
    local out=$(<"$tmp"); rm -f "$tmp"; unset_spin;
    ! (( rc == "0" )) >&2 && log_msg "spin_err" "${name} (код $rc) ${out:+ : $out}" "$sym_cancel" || log_msg "spin_ok" "${name} ${out:+ : $out}" "$sym_ok"
    return "$rc"
}

### Функции логирования:
########################
log_msg() {
    local type="$1"; local msg="$2";
    local ts=$(date '+%b %d %T');
    local entry="[${ts}] ${type}: ${msg}";
    local existed=1
    local sym="$3"
    [[ -f "${LOG_FILE}" ]] || existed=0
    case "$type" in
        info)      printstr "$(cecho Bs 'Инфо: ')$(cecho Ws "${msg}")" "${sym_info}" ;;
        ok)        printstr "$(cecho Gs 'Ок: ')$(cecho Ws "${msg}")" "${sym_ok}" ;;
        spin_wait) printf "\r    %s $(cecho Ws '%s')" "${sym}" "${msg}" ;;
        spin_ok)   printf "\r    %s $(cecho Gs 'Ок: ')$(cecho Ws '%s')\n" "${sym}" "${msg}" ;;
        confirmed) printstr "$(cecho Gs 'Подтверждено.')" "${sym_ok}" ;;
        cancelled) printstr "$(cecho Ys 'Отменено.')" "${sym_cancel}" ;;
        warning)   printstr "$(cecho Ys 'Внимание: ')$(cecho Ws "${msg}")" "${sym_warn}" ;;
        spin_warn) printf "\r    %s $(cecho Ys 'Внимание: ')$(cecho Ws '%s')\n" "${sym}" "${msg}" ;;
        save)      printstr "$(cecho Gs 'Сохраню ')$(cecho Ws "${msg}")" "${sym_ok}" ;;
        delete)    printstr "$(cecho Rs 'Удалю ')$(cecho Ws "${msg}")" "${minus}" ;;
        error)     printstr "$(cecho Rs 'Ошибка: ')$(cecho Ws "${msg}")" "${sym_err}" ;;
        spin_err)  printf "\r    %s $(cecho Rs 'Ошибка: ')$(cecho Ws '%s')\n" "${sym}" "${msg}" ;;
        debug)     printstr "$(cecho Ws 'Отладка: ')$(cecho Ws "${msg}")" "${sym_dbg}" ;;
        *) app_title "Error" "${sym_err}" ;;
    esac
    if [[ "${DEFAULT_LOG}" != "" ]] && [[ "${SAVE_LOG}" == true ]];then
        local log="${DEFAULT_LOG}";
        if ! mkdir -p "$(dirname "${log}")" || ! echo ${entry} >> "${log}"; then
            printstr "Ошибка записи лога '${log}'. $(cecho sR 'ERROR: ')" "${entry}" "${sym_err}";
            exit 1;
        fi
        # Скрипт работает под root, а каталог принадлежит admin: свежесозданный лог иначе останется root-овым и станет недоступен на запись без sudo.
        [[ "${existed}" -eq 0 && -f "${LOG_FILE}" ]] && _fix_owner "${LOG_FILE}"
    fi
}

### Функции вывода:
###################
#-> Вывод в терминал и для логирования:
log()         { log_msg "info" "$*"; }
log_ok()      { log_msg "ok" "$*"; }
log_confirm() { log_msg "confirmed"; }
log_cancel()  { log_msg "cancelled"; }
log_warn()    { log_msg "warning" "$*"; >&2; }
log_save()    { log_msg "save" "$*"; }
log_delete()  { log_msg "delete" "$*"; }
log_error()   { log_msg "error" "$*"; >&2; }
log_debug()   { log_msg "debug" "$*"; >&2; }
die()         { log_error "Сдохла: $*"; [[ "${DEFAULT_LOG}" != ""  ]] && ${SAVE_LOG}; log_error "Лог: $DEFAULT_LOG" && exit 1 || exit 1; }

print_info()    { log "$*"; }
print_ok()      { log_ok "$*"; }
print_confirm() { log_confirm; }
print_cancel()  { log_cancel; }
print_warn()    { log_warn "$*"; }
print_save()    { log_save "$*"; }
print_delete()  { log_delete "$*"; }
print_err()     { log_error "$*"; }
print_debug()     { log_error "$*"; }
print_section() {
    printf "\n  ${bmag}${bnc}$*${nc}\n"
    printf "   ${bmag}${dashes}${nc}\n";
}

### spin_msg:
#############
spin_msg() {
    local exec="$1"
    custom_spin_max_time="${2:-${spin_max_time}}"
    local msg="${3:-$exec}"
    spinstr "${exec}" ${custom_spin_max_time} "${msg}"
    case $? in
        0)  log_ok "$msg" ;;
        1)  log_error "$msg" ;;
        13) log_warn "$msg" ;;
        *)  log_error "$msg (unknown: $?)" ;;
    esac
}


