### Функции "system_check":
###########################
check_root() { [ $(id -u) -ne 0 ] && die "Нужен root!"; }
check_virt() { if grep "container=" /proc/1/environ > /dev/null 2>&1; then die "Containers is not supported."; fi }
check_os() { [[ -r /etc/os-release ]] && source "/etc/os-release"; os_id="$ID"; os_ver="$VERSION_ID" || { echo "Нет /etc/os-release!"; exit 1; }; }

#-> version_ge A B -> 0, если версия A >= B. Сравнение почленное
version_ge() {
    local a="$1" b="$2"
    [[ "$a" == "$b" ]] && return 0
    local -a pa pb
    IFS='.' read -ra pa <<<"$a"
    IFS='.' read -ra pb <<<"$b"
    local i
    for ((i = 0; i < ${#pb[@]}; i++)); do
        local x="${pa[i]:-0}" y="${pb[i]:-0}"
        ((10#${x:-0} > 10#${y:-0})) && return 0
        ((10#${x:-0} < 10#${y:-0})) && return 1
    done
    return 0
}

validate_os_ver() {
    check_os
    case "$os_id" in
        "ubuntu") version_ge "$os_ver" "22.04" && os_type="deb"  || die "Ubuntu ${os_ver}: проверялось на 24.04+!" ;;
        "debian") version_ge "$os_ver" "12"    && os_type="deb"  || die "Debian ${os_ver}: проверялось на 12+!" ;;
        "almalinux") version_ge "$os_ver" "9"  && os_type="rhel" || die "Almalinux ${os_ver}: проверялось на 9+!" ;;
        "rocky") version_ge "$os_ver" "9"      && os_type="rhel" || die "Rocky ${os_ver}: проверялось на 9+!" ;;
        "centos") version_ge "$os_ver" "9"     && os_type="rhel" || die "CentOS ${os_ver}: проверялось на 9+!" ;;
        *) die "ОС '${os_ver}' не проверялась; ожидается Ubuntu 24.04+ / Debian 12+ / Almalinux 9+ / Rocky 9+ / Centos 9+." ;;
    esac
#    print_ok "ОС: ${os_id} ${os_ver}, Тип ОС: ${os_type}"
}

### Разное:
###########
# Файлы должны остаться у владельца каталога awg, иначе старый manage_amneziawg.sh, запущенный не под root, перестанет их читать.
_fix_owner() {
    local target="$1" owner
    owner=$(stat -c '%u:%g' "$AWG_SYSCONF" 2>/dev/null) || return 0
    chown "$owner" "$target" 2>/dev/null || true
}

### Функции определения внешнего интерфейса:
############################################
#ifext="$(ip route show default 2>/dev/null | awk '/default/{print $5}' | head -1 || echo '')"
ifext="$(ip route show default | grep -oP 'dev \K\S+')";
ipext="$(curl -4 -fsSL --connect-timeout 5 ifconfig.me 2>/dev/null || echo '')"
#ipext="$(ip route show default | grep -oP 'via \K\S+')";

gdbyip() {
    if [[ "$1" != "" ]]; then
        local ip_address="$1" domains=()
    [[ "$ip_address" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local o
    for o in "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"; do
        (( 10#$o <= 255 )) || return 1
    done
        domains="$(dig -x "$ip_address" +short)"
        printf "%*s\n" "${domains[@]}"
    else
        printf "$(cecho sR "Нужен аргумент 'N' IP!")\n"
    fi
}

### Сетевые проверки:
#####################
function _ping {
if [[ "$1" != "" ]];then
    url="$1";
    index=1;
    ! command -v grep "http" | echo "$url" >/dev/null 2>&1; hostname="${url}" || hostname=$(echo "$url" | awk -F/ '{print $3}')
    rtt=$(ping -c 1 -W 1 "$hostname" 2>/dev/null | grep 'time=' | awk -F'time=' '{print $2}' | awk '{print $1}');
    rtt=${rtt//.*/};
    printf " [%i]                  %sms %s\n" "$index" "$rtt" "$url";
else
    echo "Нужен адрес!"
fi
}
