### Основные переменные:
########################
#-> Статические системные:
SYSCONF_DIR="/etc"
SYSLOGS_DIR="/var/log"
SYSRUN_DIR="/var/run"
SYSTEMD_UNIT_DIR="/usr/lib/systemd/system"
AWG_SYSCONF="/etc/amnezia/amneziawg"
#-> Статические корневые:
VPN_DIR="${SYSCONF_DIR}/VPN"
VPN_CONFIGS="${VPN_DIR}/configs"
VPN_TOOLS="${VPN_DIR}/tools"
VPN_HELPERS="${VPN_DIR}/helpers"

#-> Вычисленные:
#SELF="$(readlink -f "${BASH_SOURCE[0]}")"
#-> Новый SELF без файла на конце
SELF="$(dirname $(readlink -f "${BASH_SOURCE[0]}"))"
INCLUDE_DIR="${SELF}"
PARENT_DIR="$(dirname "${SELF}")"
#-> название проекта (берём название корневой папки)
PROJ_NAME="${PARENT_DIR##*/}"
BIN_DIR="${PARENT_DIR}/bin"
SRC_DIR="${PARENT_DIR}/src"
BUILD_SCRIPT="${PARENT_DIR}/build.sh"
PROJ_WORK_DIR="${VPN_TOOLS}/${PROJ_NAME}"
PROJ_LOCK_FILE="${SYSRUN_DIR}/${PROJ_NAME}.lock"

#-> Домашние:
HOME_DIR="${HOME:-/root}"
PROJ_ROOT_DIR="${HOME_DIR}/.${PROJ_NAME}"
PROJ_SECURE_DIR="${PROJ_ROOT_DIR}/.secure"
PROJ_BACKUPS_ROOT="${PROJ_ROOT_DIR}/.bak"
MAIN_SCRIPT="${PROJ_ROOT_DIR}/${PROJ_NAME}.sh"

#-> Инклюды:
secure_inc="${PROJ_SECURE_DIR}/.private-env"
env_inc="${INCLUDE_DIR}/.${PROJ_NAME}-env"
colors_inc="${INCLUDE_DIR}/.${PROJ_NAME}-colors"
output_inc="${INCLUDE_DIR}/.${PROJ_NAME}-output"
input_inc="${INCLUDE_DIR}/.${PROJ_NAME}-input"
functions_inc="${INCLUDE_DIR}/.${PROJ_NAME}-functions"
firewalld_inc="${INCLUDE_DIR}/.firewalld-env"

#-> Разное:
app_name=${PROJ_NAME}
app_version="v0.0.2"
pr_name="AWG Multi Tools"
pr_descr="Менеджер AWG стека: AWG VPN на хосте: $(hostname)"
pr_slogan="Хорошего дня!"
pr_owner="vados-dev"
repo_name=${PROJ_NAME}
github_url="https://github.com/"
#-> Запрос подтверждения в функции ask_confirm:
AUTO_YES=0

### НАСТРОЙКИ ВЕДЕНИЯ ЛОГОВ:
############################
#-> Их асположение можно переопределить в любом модуле достаточно
#-> вверху файла module.sh, прописать переменные:
#CUSTOM_LOGS_DIR="/path/to/logfile"
#CUSTOM_LOG_FILE="logname.log"
#-> сразу после перечиать этот файл.
#source ${PROJ_ENV}/.${me}-env
#################################################################
LOGS_DIR=${CUSTOM_LOGS_DIR:-$SYSLOGS_DIR}
LOG_FILE=${CUSTOM_LOG_FILE:-${app_name}.log}
DEFAULT_LOG="${LOGS_DIR}/${LOG_FILE}"
SAVE_LOG=true
dbg="${dbg:-0}"

### For colors:
################
#-> Ширина основных элементов:
COLS_NUM=79
#-> Можно выключить цвет:
NO_COLOR=false
### Спиннер:
############
#-> Цвет спиннера по умолчанию (cecho-код):
spin_color=${custom_spin_color:-"Ks"}
spin_max_time=${custom_spin_max_time:-"30"}

### Переменные для отладки:
###########################
#-> Для облегчения отладки меню по умолчанию:
#default_menu="menu_awg3_clients"

### Переменные для установщика модуля ядра:
###########################################
AWG_MODULE_GIT_URL="${github_url}${pr_owner}/amneziawg-linux-kernel-module.git"
AWG_MODULE_GIT_BRANCH="stable"
#amnUrl="${github_url}amnezia-vpn/amneziawg-linux-kernel-module.git"; amnBranch="master"
#advUrl="${github_url}AdvancedWG/amneziawg-linux-kernel-module-awg.git"; advBranch="master"
#AWG_MODULE_VERSION="1.0.0"
